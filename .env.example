# Copie este arquivo para .env e preencha com seus dados do Supabase
# Em Settings → API no painel do Supabase

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Compatibilidade com nome antigo:
SUPABASE_SERVICE_KEY=
eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave publicável para o fluxo de login (ou a chave anon legada).
# Esta chave pode ser usada pelo cliente de autenticação; não é a chave secreta.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
